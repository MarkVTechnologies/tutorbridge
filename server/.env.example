# Copy to .env for local development. In production set these in cPanel → Setup Python App → Environment variables.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173

# Database: "sqlite" for local dev, "mysql" for production (MySQL 8 / MariaDB 10.6+)
DB_ENGINE=sqlite
DB_NAME=tutorbridge
DB_USER=tutorbridge
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Field encryption (NIN results, bank details, learning notes, addresses).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate: the first encrypts, all decrypt. REQUIRED in production.
FIELD_ENCRYPTION_KEYS=

# Payments: paystack | flutterwave | fake (fake = local dev only, refused when DEBUG is off)
PAYMENT_GATEWAY=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# SMS: termii | console
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=TutorBridge

# KYC: manual (routes every NIN check to the vetting team) until a provider is chosen
KYC_PROVIDER=manual

SAFETY_OFFICER_PHONE=
SAFETY_OFFICER_EMAIL=safety@tutorbridge.ng

# Email: console backend prints emails to the terminal in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TutorBridge <no-reply@tutorbridge.ng>

# Private uploads must live OUTSIDE public_html
PRIVATE_MEDIA_ROOT=
